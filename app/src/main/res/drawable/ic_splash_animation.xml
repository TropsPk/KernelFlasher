<?xml version="1.0" encoding="utf-8"?>
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_splash_foreground">
    <target android:name="glowGroup">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:startOffset="200"
                    android:duration="520"
                    android:propertyName="scaleX"
                    android:valueType="floatType"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:interpolator="@android:interpolator/decelerate_cubic" />
                <objectAnimator
                    android:startOffset="200"
                    android:duration="520"
                    android:propertyName="scaleY"
                    android:valueType="floatType"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:interpolator="@android:interpolator/decelerate_cubic" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="chipGroup">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="420"
                    android:propertyName="scaleX"
                    android:valueType="floatType"
                    android:valueFrom="0.55"
                    android:valueTo="1"
                    android:interpolator="@android:interpolator/decelerate_cubic" />
                <objectAnimator
                    android:duration="420"
                    android:propertyName="scaleY"
                    android:valueType="floatType"
                    android:valueFrom="0.55"
                    android:valueTo="1"
                    android:interpolator="@android:interpolator/decelerate_cubic" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="boltGroup">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:startOffset="300"
                    android:duration="380"
                    android:propertyName="scaleX"
                    android:valueType="floatType"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:startOffset="300"
                    android:duration="380"
                    android:propertyName="scaleY"
                    android:valueType="floatType"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
